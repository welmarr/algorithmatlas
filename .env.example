# For the optional local PostgreSQL Compose stack only. Set a unique local password.
SIM_DB_PASSWORD=replace-with-a-unique-local-password
# Host development with compose.auth.yaml (use environment variables, never commit .env).
# DATABASE_URL=postgres://simulator:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/simulator
APP_URL=http://127.0.0.1:3000
EMAIL_TRANSPORT=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
MAILPIT_API=http://127.0.0.1:18025
# For real SMTP, unset EMAIL_TRANSPORT=mailpit and configure TLS server-side.
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=

# Public execution stays off until production review/preflight.
PUBLIC_PYTHON_EXECUTION_ENABLED=false
PYTHON_GUEST_EXECUTION_ENABLED=false
PYTHON_VERIFIED_EXECUTION_ENABLED=false
# Stable, independent random 32-byte hex keys (dev:python creates local keys).
# PYTHON_ORCHESTRATOR_KEY=
# EXECUTION_CAPABILITY_KEY=
# ABUSE_HASH_KEY=
# EMAIL_OUTBOX_KEY=
# PYTHON_RUNNER_IMAGE=sha256:<reviewed-immutable-image-id>
# TRUST_PROXY=true
# TRUST_PROXY_KEY=
# MAIL_FROM_ADDRESS=accounts@your-domain.example
# MAIL_FROM_NAME=Algorithm Atlas
# SMTP_USERNAME=
# SMTP_PASSWORD=
# OUTGOING_EMAIL_ENABLED=false
# EMAIL_RETENTION_DAYS=7
# EMAIL_MAX_ATTEMPTS=5
