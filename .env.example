# For the optional local PostgreSQL Compose stack only. Set a unique local password.
SIM_DB_PASSWORD=replace-with-a-unique-local-password
# Host development with compose.auth.yaml (use environment variables, never commit .env).
# DATABASE_URL=postgres://simulator:YOUR_LOCAL_PASSWORD@127.0.0.1:5432/simulator
APP_URL=http://127.0.0.1:3000
EMAIL_TRANSPORT=mailpit
SMTP_HOST=127.0.0.1
SMTP_PORT=11025
MAILPIT_API=http://127.0.0.1:18025
# For real SMTP, unset EMAIL_TRANSPORT=mailpit and configure TLS server-side.
# SMTP_SECURE=true
# SMTP_USER=
# SMTP_PASSWORD=
