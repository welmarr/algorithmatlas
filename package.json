{
  "name": "algorithm-simulator",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "pnpm --filter @sim/web dev",
    "build": "pnpm --filter @sim/web build",
    "typecheck": "tsc --noEmit && pnpm --filter @sim/web typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "contributor": "node scripts/contributor.mjs",
    "runner:build": "docker build -t simulator-python-runner:0.1 runner/python",
    "runner:local": "node scripts/run-python.mjs",
    "db:migrate": "pnpm --filter @sim/persistence migrate",
    "db:prune": "pnpm --filter @sim/persistence run prune",
    "verify": "node scripts/verify.mjs",
    "verify:full": "node scripts/verify.mjs full",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.26",
    "@playwright/test": "1.55.1",
    "@sim/ai-sdk": "workspace:*",
    "@sim/code-runtime": "workspace:*",
    "@sim/domain": "workspace:*",
    "@sim/isolated-runner": "workspace:*",
    "@sim/persistence": "workspace:*",
    "@sim/problem-sdk": "workspace:*",
    "@sim/problems": "workspace:*",
    "@sim/renderer-sdk": "workspace:*",
    "@sim/semantic-events": "workspace:*",
    "@sim/semantic-interpreter": "workspace:*",
    "@sim/simulation-core": "workspace:*",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.25.1",
    "prettier": "^3.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.11",
    "@sim/visual-choreography": "workspace:*"
  }
}
